SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://YOUR_PRIVATE_RDS_HOST:5432/invoice_db?sslmode=require
DB_USERNAME=invoice_app
DB_PASSWORD=REPLACE_WITH_DATABASE_SECRET
AWS_REGION=ap-south-1
AWS_S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
APP_BOOTSTRAP_BRANDS=aigner

# Use these four only for the first successful startup, then remove the credentials and set false.
SEED_ADMINS=true
ADMIN_BRAND_SLUG=aigner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_14_CHARACTERS
